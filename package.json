{
  "name": "colormaster",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "firebase:emulators": "firebase emulators:start --project colormaster-test --only auth,firestore,storage",
    "cy:open": "cypress open",
    "cy:run": "cypress run --e2e",
    "test:e2e": "start-server-and-test 'npm run dev:test' http://127.0.0.1:4173 'cypress run --e2e'"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "autoprefixer": "^10.5.0",
    "cypress": "^14.3.3",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.1",
    "firebase-tools": "^15.28.2",
    "lucide-react": "^1.11.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "start-server-and-test": "^2.0.5",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.10"
  }
}
